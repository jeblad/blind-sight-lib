{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 6
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
