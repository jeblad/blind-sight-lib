# Build output (CMakeUserPresets.json puts it under build/<preset>/)
build/

# Compiled GSettings schema — generated by demo/CMakeLists.txt straight into
# demo/data/ for dev-time lookup; the .gschema.xml source next to it is
# committed, this binary isn't.
demo/data/gschemas.compiled

# Editor / tooling
.cache/
compile_commands.json

# Node tooling for commit-and-tag-version (release/CHANGELOG only, not the
# build) — package-lock.json is committed, node_modules/ is not.
node_modules/

# Screenshots made during debugging
screenshots/

# Local dir for tracking AI usage
logs/

# Work dir for session files – should not be published
sessions/

# Work notes
notes.md
TODO.md

# Depth-generation Python venv (demo/depth/setup-depth-env.sh creates it) —
# requirements.txt is committed for reproducibility, the venv itself isn't.
demo/depth/.venv/
